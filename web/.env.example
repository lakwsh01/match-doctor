# Supabase dashboard: Project Settings > API.
# Use the project URL and the anon (publishable) key. Never the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# shadcn registry auth, read by the shadcn CLI/MCP via components.json. Dev tooling only; not used by the app.
# Get it from your shadcnblocks account.
SHADCNBLOCKS_API_KEY=your-shadcnblocks-api-key
